# Compose reads .env; dotnet run and EF tools do not. No real credentials belong here.
POSTGRES_DB=techvault
POSTGRES_USER=techvault
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Npgsql key/value string; set via process environment or Development user-secrets.
# Host=localhost;Port=5432;Database=techvault;Username=<user>;Password=<secret>;Timeout=5;Command Timeout=5
DATABASE_URL=
Admin__ApiKey=

# Required in Production. Replace with the real domain, without wildcard or trailing slash.
AllowedHosts=localhost
Operations__HttpsOrigin=
# Optional exact public-browser origins; empty means no cross-origin permission.
# Operations__AllowedOrigins__0=https://techvault.example
# Trust only the actual Nginx peer IP; empty means ignore forwarded headers.
# Operations__TrustedProxies__0=127.0.0.1
Operations__MaxRequestBodyBytes=1048576
Operations__PublicRequestsPerMinute=120
Operations__AdminRequestsPerMinute=30
Operations__ReadinessRequestsPerMinute=30

# Integration tests ONLY: loopback PostgreSQL maintenance connection, Database=postgres.
# Tests create/drop their own randomly named techvault_tests_* databases, never this database.
TECHVAULT_TEST_DATABASE_URL=
