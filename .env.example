# Copy to .env for Docker Compose and choose a local password.
POSTGRES_DB=techvault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456789
POSTGRES_PORT=5432

# The API and EF tools read DATABASE_URL from their process environment.
# Use an Npgsql key/value connection string, not a postgres:// URI:
# Host=localhost;Port=5432;Database=techvault;Username=postgres;Password=<your-local-password>;Timeout=5;Command Timeout=5
# dotnet does not automatically load this .env file. See README.md.
DATABASE_URL=localhost;Port=5432;Database=techvault;Username=postgres;Password=123456789;Timeout=5;Command Timeout=5
