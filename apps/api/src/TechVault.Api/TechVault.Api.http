@TechVault.Api_HostAddress = http://localhost:5078

GET {{TechVault.Api_HostAddress}}/health/live
Accept: application/json

###

# Available only in Development.
GET {{TechVault.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Returns 200 Healthy when PostgreSQL is reachable, otherwise 503 Unhealthy.
GET {{TechVault.Api_HostAddress}}/health/ready
Accept: text/plain

###

# Apply all migrations, including AddCatalogComparisons; --seed-catalog loads the four samples.
# Default sort: release-desc, page=1, pageSize=24. Published devices only.
GET {{TechVault.Api_HostAddress}}/api/v1/devices
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/nokia-3310
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/nokia-3310/specifications
Accept: application/json

###

# All filters combine with AND; category includes descendants.
GET {{TechVault.Api_HostAddress}}/api/v1/devices?brand=nokia&category=feature-phones&type=phones&year=2000&fromYear=1990&toYear=2009&decade=2000&sort=name-asc&page=1&pageSize=24
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/phones?brand=nokia&decade=2000&sort=release-asc
Accept: application/json

###

# Two Apple computers after the Phase 5 seed; empty results remain valid on an older/unseeded database.
GET {{TechVault.Api_HostAddress}}/api/v1/computers
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/brands?page=1&pageSize=24
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/brands/nokia
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/categories?page=1&pageSize=24
Accept: application/json

###

# HTTP 404, DEVICE_NOT_FOUND; unpublished slugs behave identically.
GET {{TechVault.Api_HostAddress}}/api/v1/devices/missing-device
Accept: application/json

###

# HTTP 400, VALIDATION_ERROR. pageSize must be 1..100.
GET {{TechVault.Api_HostAddress}}/api/v1/devices?pageSize=101
Accept: application/json

###

# Malformed numeric input also returns the standard JSON 400 envelope.
GET {{TechVault.Api_HostAddress}}/api/v1/devices?page=abc
Accept: application/json

###

# Original 1999 phone, not the 2024 reissue.
GET {{TechVault.Api_HostAddress}}/api/v1/devices/nokia-3210
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/nokia-3210/specifications
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/macintosh-128k
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/macintosh-128k/specifications
Accept: application/json

###

# Original 1998 233 MHz configuration.
GET {{TechVault.Api_HostAddress}}/api/v1/devices/imac-g3
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/devices/imac-g3/specifications
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/computers?brand=apple&category=all-in-one-computers&sort=release-asc
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/brands/apple
Accept: application/json

###

# Cross-category result: iMac G3 (1998), then Nokia 3210 (1999).
GET {{TechVault.Api_HostAddress}}/api/v1/devices?decade=1990&sort=release-asc
Accept: application/json

###

# Whole-word, case-insensitive full-text search across name, brand, descriptions, aliases, and model number.
GET {{TechVault.Api_HostAddress}}/api/v1/search?q=Nokia%203310
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/search?q=Apple&page=1&pageSize=2
Accept: application/json

###

# Global timeline: oldest year/date first, unknown years omitted, year-only dates stay null.
GET {{TechVault.Api_HostAddress}}/api/v1/timeline
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/timeline?era=1990s
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/timeline?type=computers&brand=apple&category=computers&fromYear=1980&toYear=1999&pageSize=24
Accept: application/json

###

# HTTP 400: search requires a nonempty q.
GET {{TechVault.Api_HostAddress}}/api/v1/search
Accept: application/json

###

# HTTP 400: era must use a decade label such as 1990s.
GET {{TechVault.Api_HostAddress}}/api/v1/timeline?era=1991s
Accept: application/json

###

# Exactly two Published, compatible device slugs; columns follow the requested order.
GET {{TechVault.Api_HostAddress}}/api/v1/compare?devices=nokia-3310,nokia-3210
Accept: application/json

###

GET {{TechVault.Api_HostAddress}}/api/v1/compare?devices=macintosh-128k,imac-g3&differencesOnly=true
Accept: application/json

###

# Reversing the pair reverses its value columns, not the specification row order.
GET {{TechVault.Api_HostAddress}}/api/v1/compare?devices=nokia-3210,nokia-3310&differencesOnly=true
Accept: application/json

###

# HTTP 400, INCOMPATIBLE_DEVICES.
GET {{TechVault.Api_HostAddress}}/api/v1/compare?devices=nokia-3310,imac-g3
Accept: application/json

###

# HTTP 400, VALIDATION_ERROR: duplicate devices are not a comparison.
GET {{TechVault.Api_HostAddress}}/api/v1/compare?devices=nokia-3310,nokia-3310
Accept: application/json

###
